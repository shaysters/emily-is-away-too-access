<Project Sdk="Microsoft.NET.Sdk">

  <!-- Emily Online (the messenger that comes with Emily is Away Too) is its own Unity 5.6
       program in the EmilyOnline folder. This mod shares the speech, navigation, text and
       icon code with Emily is Away Too Access (linked below) and adds its own screens. -->
  <PropertyGroup>
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Emily is Away Too\EmilyOnline</GameDir>
    <Managed>$(GameDir)\EmilyOnline_Data\Managed</Managed>
    <DeployDir>$(GameDir)\BepInEx\plugins\EmilyOnlineAccess</DeployDir>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFramework>net35</TargetFramework>
    <AssemblyName>EmilyOnlineAccess</AssemblyName>
    <RootNamespace>EmilyIsAwayTooAccess</RootNamespace>
    <LangVersion>7.3</LangVersion>
    <Nullable>disable</Nullable>
    <Version>1.0.4</Version>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <DefineConstants>$(DefineConstants);EMILY_ONLINE</DefineConstants>
    <DevTools Condition="'$(DevTools)' == '' And Exists('OnlineTestDriver.cs')">true</DevTools>
    <DefineConstants Condition="'$(DevTools)' == 'true'">$(DefineConstants);DEV_TOOLS</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net35" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="BepInEx"><HintPath>$(GameDir)\BepInEx\core\BepInEx.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(GameDir)\BepInEx\core\0Harmony.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine"><HintPath>$(Managed)\UnityEngine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UI"><HintPath>$(Managed)\UnityEngine.UI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Assembly-CSharp"><HintPath>$(Managed)\Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Assembly-CSharp-firstpass"><HintPath>$(Managed)\Assembly-CSharp-firstpass.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

  <!-- Shared with Emily is Away Too Access. -->
  <ItemGroup>
    <Compile Include="..\EmilyIsAwayTooAccess\Speech\PrismOutput.cs" Link="Shared\PrismOutput.cs" />
    <Compile Include="..\EmilyIsAwayTooAccess\Speech\Tell.cs" Link="Shared\Tell.cs" />
    <Compile Include="..\EmilyIsAwayTooAccess\Ui.cs" Link="Shared\Ui.cs" />
    <Compile Include="..\EmilyIsAwayTooAccess\Navigator.cs" Link="Shared\Navigator.cs" />
    <Compile Include="..\EmilyIsAwayTooAccess\Icons.cs" Link="Shared\Icons.cs" />
    <Compile Include="..\EmilyIsAwayTooAccess\SafePatch.cs" Link="Shared\SafePatch.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\prism\prism.dll" Link="prism.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\prism\LICENSE;..\..\prism\NOTICE" Link="Prism\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\prism\LICENSES\**\*" Link="Prism\LICENSES\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup Condition="'$(DevTools)' != 'true'">
    <Compile Remove="OnlineTestDriver.cs" />
  </ItemGroup>

  <Target Name="Deploy" AfterTargets="Build" Condition="Exists('$(GameDir)\BepInEx\core') And '$(SkipDeploy)' != 'true'">
    <ItemGroup>
      <DeployFiles Include="$(OutputPath)**\*" Exclude="$(OutputPath)**\*.pdb;$(OutputPath)**\*.deps.json" />
    </ItemGroup>
    <Copy SourceFiles="@(DeployFiles)" DestinationFiles="@(DeployFiles->'$(DeployDir)\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Message Importance="high" Text="Deployed to $(DeployDir)" />
  </Target>

</Project>
